# OpenRouteService — https://openrouteservice.org/dev/#/signup
# Used for workplace address autocomplete + travel-time matrix (server-side only).
OPENROUTESERVICE_API_KEY=

# Optional shared invite code required to register staff accounts.
# Leave empty to allow open registration (first user becomes manager).
# STAFF_INVITE_CODE=change-me

# Optional server port (default 8767)
# PORT=8767
